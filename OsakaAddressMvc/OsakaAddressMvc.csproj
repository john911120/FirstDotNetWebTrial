<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.6.0-alpha.1</Version>
    <!-- v0.6: 開発用の接続文字列を User Secrets（dotnet user-secrets set ...）に保存するための ID -->
    <UserSecretsId>osaka-address-mvc-d29d6bad</UserSecretsId>
  </PropertyGroup>

  <!-- 市町村一覧（Data/Municipalities.json）と区別町名データ（Data/Wards/）を出力先へコピーする -->
  <ItemGroup>
    <Content Update="Data/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- v0.6: DB マイグレーション（DbUp）。db/migration/*.sql をアセンブリに埋め込み、起動時に実行する -->
  <ItemGroup>
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="db/migration/*.sql" />
    <EmbeddedResource Include="db/migration/*.sql" />
  </ItemGroup>

</Project>
